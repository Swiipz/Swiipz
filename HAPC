          action: more-info
        icon_tap_action:
          action: more-info
        button_type: button
        sub_button:
          main:
            - entity: sensor.pc_cave_a_vin_power
              icon: mdi:lightning-bolt
              show_name: false
              show_state: true
              show_icon: true
              state_background: false
              tap_action:
                action: more-info
            - entity: sensor.pc_cave_a_vin_energy
              icon: mdi:meter-electric
              show_name: false
              show_state: true
              show_icon: true
              state_background: false
              tap_action:
                action: more-info
          bottom: []
        modules:
          - rmn_conditional_background_color
          - conditional_icon
        rmn_conditional_background_color:
          default_card_background:
            color_mode: preset
            color_preset: dark-grey
          default_icon_background:
            color_mode: preset
            color_preset: dark-grey
          conditional_background_1:
            card_background:
              color_mode: preset
              color_preset: accent
            icon_background:
              color_mode: wheel
              color_preset: dark-grey
            conditions:
              - condition: state
                entity_id: switch.pc_cave_a_vin
                state:
                  - "on"
        conditional_icon:
          icon_true: mdi:power-socket-fr
          icon_false: mdi:power-socket-fr
          advanced_settings:
            color_true: accent
            color_false: white
