                  - type: custom:bubble-card
                    card_type: button
                    button_type: name
                    icon: mdi:apps
                    name: Fonctions
                    button_action:
                      tap_action:
                        action: navigate
                        navigation_path: '#fonctions'
                    sub_button:
                      main: []
                      bottom: []
                  - type: custom:bubble-card
                    card_type: button
                    button_type: name
                    icon: mdi:webhook
                    name: Scènes
                    button_action:
                      tap_action:
                        action: navigate
                        navigation_path: '#scenes'
                    sub_button:
                      main: []
                      bottom: []
            grid_options:
              columns: 12
              rows: auto
          - type: custom:bubble-card
            card_type: separator
            name: Energie
            icon: mdi:home-lightning-bolt
            sub_button:
              main: []
              bottom: []
