              - type: custom:modern-circular-gauge
                secondary: {}
                tertiary: {}
                min: 0
                max: 800
                start_from_zero: false
                adaptive_state_color: true
                segments:
                  - from: 0
                    color:
                      - 255
                      - 38
                      - 0
                  - from: 200
                    color:
                      - 255
                      - 251
                      - 0
                  - color:
                      - 0
                      - 249
                      - 0
                    from: 600
                name: ' '
                unit: W
                needle: true
                show_unit: true
                show_state: true
                header_position: bottom
                smooth_segments: false
                adaptive_icon_color: true
                show_icon: true
