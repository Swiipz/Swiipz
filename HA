type: sections
max_columns: 3
title: HA
path: ha
icon: mdi:home-assistant
sections:
  - type: grid
    cards:
      - type: custom:bubble-card
        card_type: separator
        name: Boite au lettre
        icon: mdi:email
        sub_button:
          main: []
          bottom: []
      - type: tile
        entity: binary_sensor.do_boite_lettre_contact
        name: Boite lettre
        icon: mdi:email
        vertical: false
        features_position: bottom
      - type: tile
        entity: automation.boite_aux_lettres_ouverture
      - type: custom:bubble-card
        card_type: separator
        name: Mise à jour
        icon: mdi:update
        sub_button:
          main: []
          bottom: []
      - type: custom:auto-entities
        card:
          type: entities
          title: Mises à jour disponibles
        filter:
          include:
            - domain: update
              state: "on"
        sort:
          method: name
  - type: grid
    cards:
      - type: custom:bubble-card
        card_type: separator
        name: Sauvegarde
        icon: mdi:content-save
        sub_button:
          main: []
          bottom: []
      - type: vertical-stack
        cards:
          - type: custom:mushroom-template-card
            primary: |
              {% if is_state('binary_sensor.sauvegarde_probleme', 'on') %}
                ⚠️ Problème détecté
              {% else %}
                ✅ Sauvegardes OK
              {% endif %}
            secondary: >
              {% set t =
              states('sensor.backup_derniere_sauvegarde_automatique_reussie') %}
              {% if t not in ['unknown','unavailable','none',''] %}
                Dernière réussie : {{ as_datetime(t) | relative_time }}
              {% else %}
                Dernière réussie : Indisponible
              {% endif %}
            icon: |
              {% if is_state('binary_sensor.sauvegarde_probleme', 'on') %}
                mdi:shield-alert
              {% else %}
                mdi:shield-check
              {% endif %}
            icon_color: |
              {% if is_state('binary_sensor.sauvegarde_probleme', 'on') %}
                red
              {% else %}
                green
              {% endif %}
            entity: binary_sensor.sauvegarde_probleme
            tap_action:
              action: more-info
          - type: markdown
            content: >
              ## 📋 Résumé des sauvegardes

              ---


              ### 🕐 Dernière réussie

              # {% set t =
              states('sensor.backup_derniere_sauvegarde_automatique_reussie')
              %}{% if t not in ['unknown','unavailable','none',''] %}{{
              as_datetime(t) | relative_time }}{% else %}Indisponible{% endif %}


              ### 📅 Prochaine prévue

              # {% set t =
              states('sensor.backup_prochaine_sauvegarde_automatique_programmee')
              %}{% if t not in ['unknown','unavailable','none',''] %}{{
              as_datetime(t) | relative_time }}{% else %}Indisponible{% endif %}


              ### 🔄 Dernière tentative

              # {% set t =
              states('sensor.backup_derniere_tentative_de_sauvegarde_automatique')
              %}{% if t not in ['unknown','unavailable','none',''] %}{{
              as_datetime(t) | relative_time }}{% else %}Indisponible{% endif %}
  - type: grid
    cards:
      - type: custom:bubble-card
        card_type: separator
        name: Tests
        icon: mdi:test-tube
        sub_button:
          main: []
          bottom: []
      - type: tile
        features_position: bottom
        vertical: false
        entity: input_button.teste_notification
        tap_action:
          action: toggle
      - type: tile
        entity: input_boolean.kiosk_mode
        vertical: false
        features_position: bottom
      - type: custom:bubble-card
        card_type: separator
        name: Etats Batteries
        icon: mdi:battery
        sub_button:
          main: []
          bottom: []
      - type: custom:battery-state-card
        secondary_info: "{last_changed}"
        filter:
          include:
            - name: attributes.device_class
              value: battery
          exclude:
            - name: entity_id
              value: binary_sensor.*
            - name: entity_id
              value: sensor.ipad_*
            - name: entity_id
              value: sensor.iphone_*
            - name: entity_id
              value: sensor.tab_*
            - name: entity_id
              value: sensor.link_*
            - name: entity_id
              value: sensor.ups_*
            - name: entity_id
              value: sensor.indevolt_*
            - name: entity_id
              value: number.indevolt_*
        sort:
          by: state
        collapse:
          - group_id: null
            min: 40
        bulk_rename:
          - from: " Battery"
          - from: " level"
        colors:
          steps:
            - "#ff0000"
            - "#ffff00"
            - "#00ff00"
          gradient: true
background:
  opacity: 33
  alignment: center
  size: cover
  repeat: repeat
  attachment: fixed
  image: /api/image/serve/4d8bcfa2d6e16e78874daa8bb6098057/original
cards: []
