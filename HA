                icon: mdi:battery-charging-80
                icon_color: '#90a955'
                card_mod:
                  style: |
                    ha-card {
                      z-index: 1;
                      --ha-card-border-width: 0;
                    }
              - type: custom:bar-card
                name: HDD
                decimal: 1
                color: '#90a955'
                entities:
                  - entity: sensor.indevolt_cms_sf2000_battery_soc
                positions:
                  minmax: 'off'
                  title: 'off'
                  icon: 'off'
                  name: 'off'
                severity:
                  - color: '#B33771'
                    from: 0
                    to: 7.9
                  - color: '#B33771'
                    from: 8
                    to: 16
                card_mod:
                  style: |
                    ha-card {
                      position: absolute !important;
                      height: 100%;
                      width: 70%;
                      right: 0px;
                      bottom: 0px;
                      --ha-card-border-width: 0;
                    }
                    ha-card:after {
                      content: "";
                      position: absolute;
                      width: 100%;
                      height: 100%;
                      background: linear-gradient(to right, var(--card-background-color), transparent);
                      --ha-card-border-width: 0;
                    }
            columns: 1
            card_mod:
              style: |
                ha-card {
                --ha-card-border-width: 0;
                 }
          - type: vertical-stack
            cards:
              - type: custom:bubble-card
