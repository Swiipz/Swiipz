          - type: vertical-stack
            cards:
              - type: markdown
                content: |2

                    {% set temp = states('sensor.sonde_th_sejour_temperature') | float(0) %}
                    {% set consigne = states('input_number.consigne_confort_poele') | float(22) %}
                    {% set anticip = states('input_number.anticipation_chauffage_poele') | int(0) %}
                    {% set vitesse = states('sensor.vitesse_chauffe_poele') | float(0) %}
                    {% set next_event = state_attr('schedule.sc_chauf_sejour', 'next_event') %}
                    {% set hvac = states('climate.poele_sejour') %}
                    {% set ecart = [consigne - temp, 0] | max | round(1) %}

                    🌡️ **{{ temp | round(1) }}°C** → consigne **{{ consigne | round(1) }}°C** (écart **{{ ecart }}°C**)

                    
                    {% if next_event %}
                    {% set delta = ((as_timestamp(next_event) - now().timestamp()) / 60) | int %}
                    📅 Plage : **{{ as_timestamp(next_event) | timestamp_custom('%d/%m à %H:%M') }}** (dans **{{ delta }} min**)

                    {% if temp >= consigne %}
                    ✅ **Température atteinte** — pas de chauffe nécessaire
                    {% elif delta <= 0 %}
                    🔥 **Plage active** — le poêle devrait chauffer
                    {% elif delta <= anticip and delta > 0 %}
                    🔥 **Démarrage anticipé !** — {{ delta }} min avant la plage
                    {% elif delta <= anticip + 30 %}
                    ⏳ **Démarrage dans {{ [delta - anticip, 0] | max }} min**
                    {% else %}
                    💤 **En veille** — démarrage anticipé dans **{{ delta - anticip }} min**
                    {% endif %}

                    {% else %}
                    ❌ **Pas de plage programmée**
                    {% endif %}
          - type: entities
