            - entity: sensor.sonde_th_sejour_battery
              show_state: true
              state_background: false
            - entity: sensor.sonde_th_sejour_last_seen
              show_last_updated: true
              state_background: false
          bottom: []
      - type: horizontal-stack
        cards:
          - type: custom:stack-in-card
            cards:
              - type: custom:mushroom-entity-card
                entity: sensor.sonde_th_sejour_temperature
                primary_info: state
                secondary_info: none
                card_mod:
                  style: |
                    ha-card {
                      z-index: 1;
                      --ha-card-border-width: 0;
                    }
              - type: custom:mini-graph-card
                entities:
                  - entity: sensor.sonde_th_sejour_temperature
                    name: Conso
                    color_thresholds:
                      - value: 15
                        color: "#00b4d8"
                      - value: 20
                        color: "#a7c957"
                      - value: 23
                        color: "#ffbd00"
                      - value: 25
                        color: "#ffba08"
                      - value: 27
                        color: "#faa307"
                      - value: 29
                        color: "#d00000"
                    smoothing: false
                    aggregate_func: min
                height: 80
                hours_to_show: 8
                points_per_hour: 15
                line_width: 1
                animate: true
                show:
                  name: false
                  icon: false
                  state: false
                  legend: false
                  fill: fade
                card_mod:
                  style: |
                    ha-card {
                      position: absolute !important;
                      height: 100%;
                      width: 80%;
                      right: 0px;
                      bottom: 0px;
                      --ha-card-border-width: 0;
                    }
                    ha-card:after {
                      content: "";
                      position: absolute;
                      width: 100%;
                      height: 100%;
                      --ha-card-border-width: 0;
                    }
            card_mod:
