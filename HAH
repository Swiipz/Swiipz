                    {% set temp = states('sensor.sonde_th_sejour_temperature') | float(0) %}
                    {% set consigne = states('input_number.consigne_confort_poele') | float(22) %}
                    {% set anticip = states('input_number.anticipation_chauffage_poele') | int(0) %}
