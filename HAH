      - type: vertical-stack
        cards:
          - type: vertical-stack
            cards:
              - type: horizontal-stack
                cards:
                  - type: custom:button-card
                    entity: sensor.sonde_th_sejour_temperature
                    show_name: false
                    show_state: true
                    show_icon: true
                    icon: mdi:home-thermometer
                    tap_action:
                      action: navigate
                      navigation_path: "#poele"
                    styles:
                      card:
                        - border-radius: 12px
                        - padding: 24px
                        - background: "#1c1c1e"
                      icon:
                        - width: 32px
                        - height: 32px
                        - color: |
                            [[[
                              const t = parseFloat(states['sensor.sonde_th_sejour_temperature'].state);
                              if (t < 17) return '#90caf9';
                              if (t < 19) return '#64b5f6';
                              if (t < 21) return '#4dd0e1';
                              if (t < 23) return '#81c784';
                              if (t < 25) return '#ffb74d';
                              return '#e57373';
                            ]]]
                      state:
                        - font-size: 37px
                        - font-weight: 700
                        - letter-spacing: "-1px"
                        - color: |
                            [[[
                              const t = parseFloat(states['sensor.sonde_th_sejour_temperature'].state);
                              if (t < 17) return '#90caf9';
                              if (t < 19) return '#64b5f6';
                              if (t < 21) return '#4dd0e1';
                              if (t < 23) return '#81c784';
                              if (t < 25) return '#ffb74d';
                              return '#e57373';
                            ]]]
                  - type: custom:button-card
                    entity: sensor.gw2000a_outdoor_temperature
                    show_name: false
                    show_state: true
                    show_icon: true
                    tap_action:
                      action: navigate
                      navigation_path: "#meteo"
                    icon: |
                      [[[
                        const weather = states['weather.joux_la_ville'].state;
                        const icons = {
                          'sunny': 'mdi:weather-sunny',
                          'partlycloudy': 'mdi:weather-partly-cloudy',
                          'cloudy': 'mdi:weather-cloudy',
                          'rainy': 'mdi:weather-rainy',
                          'pouring': 'mdi:weather-pouring',
                          'snowy': 'mdi:weather-snowy',
                          'snowy-rainy': 'mdi:weather-snowy-rainy',
                          'windy': 'mdi:weather-windy',
                          'windy-variant': 'mdi:weather-windy-variant',
                          'fog': 'mdi:weather-fog',
                          'hail': 'mdi:weather-hail',
                          'lightning': 'mdi:weather-lightning',
                          'lightning-rainy': 'mdi:weather-lightning-rainy',
                          'clear-night': 'mdi:weather-night',
                          'exceptional': 'mdi:weather-exceptional'
                        };
                        return icons[weather] || 'mdi:weather-cloudy';
                      ]]]
                    styles:
                      card:
                        - border-radius: 12px
                        - padding: 24px
                        - background: "#1c1c1e"
                      icon:
                        - width: 32px
                        - height: 32px
                        - color: |
                            [[[
                              const t = parseFloat(states['sensor.gw2000a_outdoor_temperature'].state);
                              if (t < 0)  return '#b3e5fc';
                              if (t < 5)  return '#90caf9';
                              if (t < 10) return '#64b5f6';
                              if (t < 15) return '#4dd0e1';
                              if (t < 20) return '#81c784';
                              if (t < 25) return '#ffb74d';
                              if (t < 30) return '#ff8a65';
                              return '#e57373';
                            ]]]
                      state:
                        - font-size: 37px
                        - font-weight: 700
                        - letter-spacing: "-1px"
                        - color: |
                            [[[
                              const t = parseFloat(states['sensor.gw2000a_outdoor_temperature'].state);
                              if (t < 0)  return '#b3e5fc';
                              if (t < 5)  return '#90caf9';
                              if (t < 10) return '#64b5f6';
                              if (t < 15) return '#4dd0e1';
                              if (t < 20) return '#81c784';
                              if (t < 25) return '#ffb74d';
                              if (t < 30) return '#ff8a65';
                              return '#e57373';
                            ]]]
