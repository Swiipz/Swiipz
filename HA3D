                show:
                  name: false
                  icon: false
                  state: false
                  legend: false
                  fill: fade
                card_mod:
                  style: |
                    ha-card {
                      position: absolute !important;
                      height: 100%;
                      width: 80%;
                      right: 0px;
                      bottom: 0px;
                      --ha-card-border-width: 0;
                    }
                    ha-card:after {
                      content: "";
                      position: absolute;
                      width: 100%;
                      height: 100%;
                     
                      --ha-card-border-width: 0;
                    }
            card_mod:
              style: |
                ha-card {
                --ha-card-border-width: 0;
                 }
      - type: custom:bubble-card
        card_type: button
        entity: input_boolean.btv_imprimante_3d
        icon: mdi:printer-3d
        sub_button:
          - entity: sensor.pc_imprimante_3d_power
            show_state: true
        force_icon: true
        show_state: true
        show_last_changed: true
        show_attribute: false
